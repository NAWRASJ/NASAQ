// NASAQ icon revision: vertical-n
strawberry ICON "${CMAKE_SOURCE_DIR}/dist/windows/strawberry.ico"
1 VERSIONINFO
FILEVERSION     ${NASAQ_VERSION_RESOURCE}
PRODUCTVERSION  ${NASAQ_VERSION_RESOURCE}
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904E4"
    BEGIN
      VALUE "CompanyName", "NASAQ Project"
      VALUE "FileDescription", "NASAQ Commercial Audio Manager"
      VALUE "FileVersion", "${NASAQ_VERSION}"
      VALUE "InternalName", "strawberry"
      VALUE "OriginalFilename", "NASAQ.exe"
      VALUE "ProductName", "NASAQ"
      VALUE "ProductVersion", "${NASAQ_VERSION}"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1252
  END
END
